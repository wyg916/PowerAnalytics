# Dedicated publisher process only. Never load these variables into the API process.
RAG_RELEASE_WORKER_TOKEN=
RAG_RELEASE_DATABASE_URL=
# Absolute path to the untracked Qdrant runtime env file.
RAG_RELEASE_QDRANT_ENV_FILE=

# Start on loopback only:
# uvicorn backend.app.workers.rag_release_worker_app:app --host 127.0.0.1 --port 8787
