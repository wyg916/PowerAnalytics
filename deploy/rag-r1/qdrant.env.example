# Copy to an untracked file and set an absolute path outside the repository.
# POSIX example: /var/lib/poweranalytics/rag-r1/qdrant
# Windows example: D:/PowerAnalyticsData/rag-r1/qdrant
RAG_R1_QDRANT_ROOT=
QDRANT_PORT=6333
QDRANT_IMAGE_DIGEST=
QDRANT_ADMIN_API_KEY=
QDRANT_READ_ONLY_API_KEY=
RAG_EMBEDDING_VERSION=
RAG_RERANK_VERSION=
RAG_ENABLED=0
RAG_RELEASE_ID=RAG-R1
RAG_QDRANT_COLLECTION=rag_chunks_RAG-R1
